# --- Models (OpenRouter) ---
OPENROUTER_API_KEY=
# openrouter/auto lets OpenRouter's router pick a model per request; it's the
# default in config/models.json too. Until you add billing/credits, swap in a
# specific `:free`-suffixed model id (e.g. meta-llama/llama-3.3-70b-instruct:free)
# in config/models.json to guarantee $0 spend — `auto` can route to paid models.
OPENROUTER_MODEL=openrouter/auto
# optional cheaper model for the 8 specialist subagents:
# OPENROUTER_SUBAGENT_MODEL=anthropic/claude-haiku-4.5

# --- Durability (Postgres container, docker-compose service `postgres`) ---
WORKFLOW_POSTGRES_URL=postgres://world:world@localhost:5544/world
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_QUEUE_NAMESPACE=eve

# --- Auth (BetterAuth + Google OAuth; uses the same Postgres) ---
# generate with: openssl rand -base64 32   (or npx @better-auth/cli secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# optional separate auth DB (defaults to WORKFLOW_POSTGRES_URL):
# AUTH_DATABASE_URL=

# --- structapi (deterministic REST API for PlanForge / backend callers) ---
# comma-separated API keys; unset = open dev mode (logged loudly)
STRUCTAPI_KEYS=
STRUCTAPI_RATE_LIMIT=60

# --- Telegram channel (agent/channels/telegram.ts; private, owner-only bot) ---
# from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# random secret you also pass to Telegram's setWebhook; see docs/DEPLOY-TELEGRAM.md
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# your numeric Telegram user id (from @userinfobot) — the only sender the
# bot will respond to. Personal; set only in your real .env, never here.
TELEGRAM_OWNER_ID=
